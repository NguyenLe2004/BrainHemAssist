# Copy locally to .env; this file is only a template.
BRAINHEM_FEEDBACK_ADMIN=admin
BRAINHEM_FEEDBACK_ADMIN_PASSWORD="" # Set locally; no default credential
BRAINHEM_FEEDBACK_USER=user
BRAINHEM_FEEDBACK_USER_PASSWORD="" # Set locally; no default credential
BRAINHEM_RBAC_ENABLED=true
# Opt in to importing local NIfTI/DICOM files through the UI.
BRAINHEM_DIRECT_UPLOAD_ENABLED=false
BRAINHEM_DATA_DIR=./data
BRAINHEM_INFERENCE_COMMAND=""
BRAINHEM_INFERENCE_STANDARD_COMMAND=""
BRAINHEM_INFERENCE_HIGH_COMMAND=""
BRAINHEM_SUPPORT_AGY_PATH=""
BRAINHEM_SUPPORT_LOCAL_URL=""
BRAINHEM_SUPPORT_LOCAL_MODEL=""
